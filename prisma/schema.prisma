generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── ZaiMem: Session Memory & Context Enhancer for chat.z.ai ────────────────

model User {
  id          String        @id @default(cuid())
  token       String        @unique // zm_<64hex> private access token
  label       String? // optional display label
  headroom    Boolean       @default(false) // Headroom mode — compress context injections harder (headroomlabs-ai/headroom pattern)
  createdAt   DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  sessions    Session[]
  memories    Memory[]
  skills      Skill[]
  ledgerPages LedgerPage[]
  usageStats  UsageStat[]
  github      GithubLink?
  syncLogs    SyncLog[]
  answerCaches AnswerCache[]
  projects    Project[]
}

model Session {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId  String? // chat.z.ai session id when provided by the agent
  title       String       @default("Untitled session")
  topic       String?
  origin      String       @default("agent") // agent (auto-created via MCP) | user (pre-created by the user)
  brief       String? // for pre-created sessions: what the future session should work on
  project     String? // project namespace — scoped recall/enhance when set
  status      String       @default("active") // active | summarized | archived
  summary     String? // distilled end-of-session digest
  metadata    String? // JSON blob (client info, tags…)
  turns       Int          @default(0)
  tokensSaved Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memories    Memory[]
  ledgerPages LedgerPage[]

  @@index([userId, updatedAt])
}

model Memory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  kind        String   @default("fact") // fact | decision | preference | reflection | workflow | summary | document
  content     String
  keywords    String? // comma-separated keywords
  embedding   String // JSON float[] — local hashed n-gram vector
  importance  Float    @default(0.5)
  pinned      Boolean  @default(false) // pinned memories are always injected into enhance_context
  accessCount Int      @default(0)
  source      String? // source filename for document chunks (file ingestion)
  docHash     String? // sha256[:16] of normalized doc text — idempotent re-ingest
  project     String? // project namespace — scoped recall/enhance when set
  supersededBy String? // id of the memory that replaced this one (conflict chain)
  quarantined Boolean  @default(false) // injection guard — never auto-injected into enhance_context
  archived    Boolean  @default(false) // decayed memory — excluded from recall, kept for audit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, kind])
  @@index([userId, source])
  @@index([userId, project])
  @@index([sessionId])
}

// enhance_context decision cache — reuses the last memory-id selection for a
// semantically identical message within its TTL (skips the cosine scan)
model AnswerCache {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  queryKey  String // sha1 of normalized query text
  memoryIds String // JSON string[] — memory ids chosen last time
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, queryKey])
  @@index([userId, updatedAt])
}

// Smart-skill integration: SKILL.md registry (builtin + user skills)
model Skill {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String // e.g. "smart"
  description String // description doubles as trigger spec (SKILL.md convention)
  triggers    String // JSON string[] — trigger phrases/regex seeds
  body        String // full SKILL.md body (markdown protocol)
  source      String   @default("builtin") // builtin | user
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
}

// zcode-smart-skill filesystem ledger (.smart/<slug>/) mapped to server pages
model LedgerPage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  path      String // "notes.md" | "tasks.json" | "workflows.md" | custom
  content   String
  budget    Int? // size budget (words/chars per smart-skill discipline)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sessionId, path])
}

model UsageStat {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String // save_tokens | remember | recall | enhance | summary | detect_skill
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  tokensSaved Int      @default(0)
  detail      String? // JSON detail
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── GitHub Cloud DB: user-paired private repo mirroring all ZaiMem data ────

model GithubLink {
  id         String    @id @default(cuid())
  userId     String    @unique // one cloud DB per user
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patEnc     String // AES-256-GCM encrypted GitHub Personal Access Token
  patHint    String // last 4 chars for display, e.g. ••••ab12
  login      String // GitHub username (denormalized for UI)
  repoName   String // e.g. zaimem-cloud-db
  repoFull   String // e.g. octocat/zaimem-cloud-db
  repoUrl    String // html_url
  branch     String    @default("main")
  autoSync   Boolean   @default(true) // auto-push after every data change
  scheduleEnabled  Boolean   @default(true) // daily scheduled full backup
  lastScheduledAt  DateTime? // last time the scheduled backup ran for this user
  status     String    @default("active") // active | error | syncing
  lastError  String?
  lastSyncAt DateTime?
  syncCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

model SyncLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // pair | create_repo | push | force_sync | unpair | auto | error
  status    String // ok | error
  files     Int      @default(0)
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── v1.7 Projects: shared workspace where a team of agents collaborates ─────

model Project {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String // canonical namespace — matches Memory.project / Session.project
  description  String?
  instructions String? // team brief: goals, conventions, how agents should work
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  files        ProjectFile[]
  agents       ProjectAgent[]

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String // file name with extension, e.g. spec.md
  content   String // full text content (instructions, prompts, specs)
  size      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
}

model ProjectAgent {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String // agent identity, e.g. "frontend-dev"
  role       String? // e.g. "frontend" | "reviewer" | "tester"
  joinedVia  String   @default("manual") // manual (dashboard) | mcp (agent joined itself)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([projectId, name])
  @@index([projectId, lastSeenAt])
}
